+def compute_agentstar_diagnostics(batch: DataProto, distillation_lambda: float = 0.0) -> dict[str, Any]:
+    """Compute Agent-STAR diagnostics that veRL does not aggregate by default.
+
+    Kept separate from ``compute_data_metrics`` so the upstream metric surface stays
+    stable. All values are scalar floats suitable for the console logger.
+    """
+    metrics: dict[str, Any] = {}
+    batch_size = len(batch)
+    if batch_size == 0:
+        return metrics
+
+    terminations = batch.non_tensor_batch.get("termination")
+    if terminations is not None:
+        normalized = [str(value).upper() if value is not None else "MISSING" for value in terminations]
+        counts: dict[str, int] = defaultdict(int)
+        for value in normalized:
+            counts[value] += 1
+        for value, count in sorted(counts.items()):
+            key = value.lower().replace(" ", "_").replace("/", "_")
+            metrics[f"termination/{key}_ratio"] = count / batch_size
+        abnormal = {"TIMEOUT", "ERROR", "TRUNCATION", "MAX_STEPS", "FORMAT_ERROR"}
+        metrics["termination/abnormal_ratio"] = sum(value in abnormal for value in normalized) / batch_size
+
+    uids = batch.non_tensor_batch.get("uid")
+    accuracies = batch.non_tensor_batch.get("acc")
+    if uids is not None and accuracies is not None and len(uids) == len(accuracies):
+        grouped: dict[str, list[float]] = defaultdict(list)
+        for uid, accuracy in zip(uids, accuracies, strict=False):
+            try:
+                value = float(accuracy)
+            except (TypeError, ValueError):
+                continue
+            if np.isfinite(value):
+                grouped[str(uid)].append(value)
+        group_means = [float(np.mean(values)) for values in grouped.values() if len(values) >= 2]
+        if group_means:
+            means = np.asarray(group_means, dtype=np.float64)
+            metrics["group/count"] = len(means)
+            metrics["group/success_rate"] = float(means.mean())
+            metrics["group/all_correct_ratio"] = float(np.mean(means >= 1.0 - 1e-6))
+            metrics["group/all_wrong_ratio"] = float(np.mean(means <= 1e-6))
+            metrics["group/zero_variance_ratio"] = float(
+                np.mean((means <= 1e-6) | (means >= 1.0 - 1e-6))
+            )
+
+    response_mask = batch.batch.get("response_mask")
+    teacher_logprobs = batch.batch.get("teacher_logprobs")
+    if response_mask is not None and teacher_logprobs is not None:
+        if teacher_logprobs.is_nested:
+            teacher_logprobs = teacher_logprobs.to_padded_tensor(0.0)
+        if teacher_logprobs.dim() == 3:
+            teacher_logprobs = teacher_logprobs[..., 0]
+        mask = response_mask.bool()
+        if (
+            teacher_logprobs.dim() == 2
+            and teacher_logprobs.shape[0] == mask.shape[0]
+            and teacher_logprobs.shape[1] >= mask.shape[1]
+        ):
+            teacher_logprobs = teacher_logprobs[:, -mask.shape[1] :]
+            teacher_signal = torch.isfinite(teacher_logprobs) & (teacher_logprobs != 0)
+            active_tokens = (mask & teacher_signal).sum()
+            valid_tokens = mask.sum()
+            token_ratio = (active_tokens / valid_tokens).item() if valid_tokens.item() else 0.0
+            active_samples = (mask & teacher_signal).any(dim=1)
+            metrics["opd/teacher_token_ratio"] = token_ratio
+            metrics["opd/teacher_sample_ratio"] = active_samples.float().mean().item()
+            metrics["distillation/lambda"] = float(distillation_lambda)
+            metrics["distillation/lambda_eff"] = float(distillation_lambda) * token_ratio
+
+    steps_by_sample = batch.non_tensor_batch.get("steps")
+    if steps_by_sample is not None:
+        total_steps = 0
+        error_steps = 0
+        repeated_steps = 0
+        for trajectory in steps_by_sample:
+            if not isinstance(trajectory, (list, tuple)):
+                continue
+            seen_actions: set[str] = set()
+            for step in trajectory:
+                total_steps += 1
+                if not isinstance(step, dict):
+                    continue
+                metadata = step.get("metadata") or {}
+                if isinstance(metadata, dict) and str(metadata.get("error", "")).strip():
+                    error_steps += 1
+                action = step.get("action")
+                try:
+                    action_key = json.dumps(action, sort_keys=True, default=str)
+                except (TypeError, ValueError):
+                    action_key = repr(action)
+                if action_key in seen_actions:
+                    repeated_steps += 1
+                seen_actions.add(action_key)
+        metrics["tool/steps_per_sample"] = total_steps / batch_size
+        metrics["tool/error_step_ratio"] = error_steps / total_steps if total_steps else 0.0
+        metrics["tool/repeated_action_ratio"] = repeated_steps / total_steps if total_steps else 0.0
+
+    calls_by_sample = batch.non_tensor_batch.get("calls")
+    if calls_by_sample is not None:
+        total_calls = 0
+        length_finishes = 0
+        for calls in calls_by_sample:
+            if not isinstance(calls, (list, tuple)):
+                continue
+            for call in calls:
+                total_calls += 1
+                if isinstance(call, dict) and str(call.get("finish_reason", "")).lower() in {
+                    "length",
+                    "max_tokens",
+                }:
+                    length_finishes += 1
+        metrics["generation/calls_per_sample"] = total_calls / batch_size
+        metrics["generation/length_finish_ratio"] = length_finishes / total_calls if total_calls else 0.0
+
+    return metrics
+
+
